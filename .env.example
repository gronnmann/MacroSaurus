# Database used by the Spring Boot backend
DATABASE_URL=jdbc:postgresql://localhost:5432/macrosaurus
DATABASE_USERNAME=macrosaurus
DATABASE_PASSWORD=macrosaurus

# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Development identity is local-only. The prod profile forces it off and
# requires Supabase Auth configuration.
DEV_AUTH_ENABLED=true
SUPABASE_URL=

# Open Food Facts
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=Macrosaurus/0.1 (replace-with-contact@example.com)
OFF_CONNECT_TIMEOUT=5s
OFF_READ_TIMEOUT=15s

# OpenRouter nutrition-label extraction
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_CONNECT_TIMEOUT=5s
OPENROUTER_READ_TIMEOUT=90s
