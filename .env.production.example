# GitHub Container Registry image prefix, release tag, and localhost proxy port.
# Use main for a test deployment or an immutable v* / sha-* tag for production.
IMAGE_REPOSITORY=ghcr.io/gronnmann/macrosaurus
APP_VERSION=main
APP_PORT=8080
APP_ORIGIN=https://macrosaurus.example.com

# Supabase PostgreSQL. Prefer the direct connection for this persistent backend;
# use the session pooler on port 5432 when the deployment host is IPv4-only.
DATABASE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=macrosaurus_app
DATABASE_PASSWORD=replace-with-a-secret

# Supabase Auth. The publishable key is intentionally public and embedded in the web build.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
ADMIN_USER_IDS=replace-with-your-supabase-user-uuid

# External providers
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=Macrosaurus/0.1 (ops@example.com)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# JVM container memory policy
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
