{
    "name": "macrosaurus-web",
    "private": true,
    "version": "0.1.0",
    "packageManager": "pnpm@10.25.0",
    "type": "module",
    "scripts": {
        "dev": "vite --config vite.config.ts",
        "build": "tsc --noEmit && vite build --config vite.config.ts",
        "check": "tsc --noEmit --pretty false",
        "format": "biome check --write .",
        "format:check": "biome check .",
        "lint": "biome lint .",
        "quality": "biome ci . && tsc --noEmit --pretty false",
        "test": "vitest run --config vitest.config.ts",
        "test:watch": "vitest --config vitest.config.ts",
        "e2e": "playwright test",
        "storybook": "storybook dev -p 6006",
        "storybook:build": "storybook build"
    },
    "dependencies": {
        "@fontsource-variable/dm-sans": "^5.3.0",
        "@fontsource/barlow-condensed": "^5.3.0",
        "@hookform/resolvers": "^5.9.1",
        "@supabase/supabase-js": "^2.112.3",
        "@tanstack/react-query": "5.90.20",
        "@zxing/browser": "^0.2.1",
        "lucide-react": "^1.31.0",
        "react": "19.2.7",
        "react-aria-components": "^1.20.0",
        "react-dom": "19.2.7",
        "react-hook-form": "^7.85.0",
        "react-router-dom": "^7.18.2",
        "workbox-window": "^7.4.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.8",
        "@playwright/test": "^1.62.1",
        "@storybook/addon-a11y": "^10.5.8",
        "@storybook/addon-vitest": "^10.5.8",
        "@storybook/react-vite": "^10.5.8",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.4",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "5.1.2",
        "@vitest/browser-playwright": "^4.1.10",
        "jsdom": "^30.0.1",
        "playwright": "^1.62.1",
        "storybook": "^10.5.8",
        "typescript": "5.9.3",
        "vite": "7.3.1",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.10"
    }
}
