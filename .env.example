# Database used by the Spring Boot backend
DATABASE_URL=jdbc:postgresql://localhost:5432/macrosaurus
DATABASE_USERNAME=macrosaurus
DATABASE_PASSWORD=macrosaurus

# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave blank only for local development. Production must configure an OIDC issuer.
AUTH0_ISSUER_URI=
AUTH0_AUDIENCE=https://api.macrosaurus.app

# Open Food Facts
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=Macrosaurus/0.1 (replace-with-contact@example.com)

# OpenRouter nutrition-label extraction
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
